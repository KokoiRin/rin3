{
  "name": "rin3-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:browser": "playwright install chromium",
    "test:ci": "node --test tests/ci-workflows.test.mjs",
    "test:e2e": "node scripts/browser.mjs",
    "verify": "npm run test && npm --prefix .. run check:fast && npm --prefix .. run check:publish && node scripts/browser.mjs --with-static",
    "test": "node --test tests/browser-runner.test.mjs tests/ci-workflows.test.mjs"
  },
  "devDependencies": {
    "playwright-chromium": "1.62.1"
  }
}
